# --- Supabase ---
# Project URL and anon (publishable) key from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Service role key — server-only, NEVER expose to the browser. Used by /admin and seeding scripts.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- AI Chatbot ---
# Anthropic is the default in src/lib/ai/chatbot.ts. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional fallback / alternate. If set and ANTHROPIC_API_KEY is empty, OpenAI is used.
OPENAI_API_KEY=

# --- Site ---
# Production: https://www.waronretailguyana.com — use http://localhost:3000 for local dev
NEXT_PUBLIC_SITE_URL=https://www.waronretailguyana.com
NEXT_PUBLIC_SITE_NAME=War on Retail

# --- Contact / Business ---
ADMIN_EMAIL=admin@waronretail.com
NEXT_PUBLIC_WHATSAPP_NUMBER=5926943827

# --- Email (Resend) ---
# Optional in development: with RESEND_API_KEY unset, the app records every send
# in the email_log table as "logged" (and console-warns) instead of delivering,
# so the whole flow can be built/tested before a Resend account exists.
# Get a key at https://resend.com and verify the sending domain to deliver for real.
RESEND_API_KEY=
# Sender + reply-to. The sending domain must be verified in Resend.
EMAIL_FROM=noreply@waronretail.com
EMAIL_REPLY_TO=support@waronretail.com

# --- Admin auth ---
# Comma-separated emails that are allowed into /admin (must match a Supabase Auth user).
ADMIN_ALLOWED_EMAILS=admin@waronretail.com

# --- Catalogue ---
# How many days a product stays flagged "New" after creation. Drives the green
# NEW badge on product cards and the "Just Arrived" strip on the homepage.
# Valid range: 1–365. Default if unset/invalid: 30.
NEW_ARRIVAL_DAYS=30
